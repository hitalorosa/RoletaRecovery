# Roleta Recovery — Dry Skin. Preencher no painel da Vercel (Environment Variables).
# NUNCA commitar o .env real (está no .gitignore).

ROLETA_MODE=dry-run                 # 'dry-run' (só conta) ou 'live' (envia). Comece em dry-run.

# Supabase dos leads da roleta
LEADS_SUPABASE_URL=
LEADS_SUPABASE_SERVICE_ROLE=

# Nextags — API pública da conta da Dry (formato 1184671.xxxx)
NEXTAGS_API_AUTO=

# Yampi (corta quem já comprou). ALIAS é o que separa Dry de Nouê — conferir!
YAMPI_ALIAS=
YAMPI_TOKEN=
YAMPI_SECRET=

# flow_id de cada janela (Nextags). MSG2/MSG3 só rodam se a env existir.
NEXTAGS_FLOW_MSG1=
NEXTAGS_FLOW_MSG2=
NEXTAGS_FLOW_MSG3=

# Métrica (pode apontar pro MESMO Supabase dos leads)
DASH_SUPABASE_URL=
DASH_SUPABASE_SERVICE_ROLE=

# Protege o endpoint: o cron precisa passar ?key=<CRON_SECRET>
CRON_SECRET=
